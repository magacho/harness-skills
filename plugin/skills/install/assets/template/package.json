{
  "name": "harness-template",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint modules",
    "boundaries": "depcruise --config .dependency-cruiser.js modules",
    "boundaries:graph": "depcruise --config .dependency-cruiser.js --output-type dot modules | dot -Tsvg > docs/dependency-graph.svg",
    "test": "vitest run"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5.9.3",
    "vitest": "^2"
  }
}
