{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(./ops/investigate.sh:*)",
      "Bash(./.harness/stats.sh:*)",
      "Bash(./ops/deploy.sh stg*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./ops/secrets/**)",
      "Bash(./ops/deploy.sh prd*)",
      "Bash(git push --force*)",
      "Bash(aws * --profile prd*)",
      "Bash(psql *prd*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-prod.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/on-edit.sh",
            "args": [],
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.sh",
            "args": [],
            "statusMessage": "lint + types + fronteiras",
            "timeout": 240
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cleanup.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
